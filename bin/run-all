#!/usr/bin/env bash
# Runs one example in every language and checks that they all print the same thing.
#
#   bin/run-all verify_webhook        offline, no key needed
#   bin/run-all booking               needs ZUBOKLIK_API_KEY (and optionally ZUBOKLIK_API_URL)
#   bin/run-all patients
#   bin/run-all webhooks
#   bin/run-all booking ruby go       only the listed languages

set -uo pipefail
cd "$(dirname "$0")/.."

example=${1:?usage: bin/run-all verify_webhook|booking|patients|webhooks [language...]}
shift
case $example in
  verify_webhook|booking|patients|webhooks) ;;
  *) echo "unknown example: $example" >&2; exit 2 ;;
esac
languages=("$@")
(( ${#languages[@]} )) || languages=(curl ruby php python javascript csharp java kotlin go swift rust cpp)

# booking -> Booking, verify_webhook -> VerifyWebhook
pascal=$(awk -F_ '{ for (i = 1; i <= NF; i++) printf "%s%s", toupper(substr($i, 1, 1)), substr($i, 2) }' <<<"$example")

command_for() {
  case $1 in
    curl)
      # curl sends requests; there is no signature to verify with it
      [[ $example == verify_webhook ]] || echo "./$example.sh" ;;
    ruby)       echo "ruby $example.rb" ;;
    php)        echo "php $example.php" ;;
    python)     echo "python3 $example.py" ;;
    javascript) echo "node $example.mjs" ;;
    csharp)     echo "dotnet run $pascal.cs" ;;
    java)       echo "mvn -q compile exec:java -Dexec.mainClass=$pascal" ;;
    kotlin)     echo "kotlin $example.main.kts" ;;
    go)         echo "go run ./$example" ;;
    swift)      echo "swift $example.swift" ;;
    rust)       echo "cargo run --quiet --bin $example" ;;
    cpp)        echo "cmake -B build -DCMAKE_BUILD_TYPE=Release >/dev/null && cmake --build build >/dev/null && ./build/$example" ;;
    *) echo "unknown language: $1" >&2; return 2 ;;
  esac
}

expected=''
failed=0
for language in "${languages[@]}"; do
  command=$(command_for "$language") || exit 2
  [[ -n $command ]] || continue

  errors=$(mktemp)
  if output=$(cd "$language" && eval "$command" 2>"$errors"); then
    if [[ -z $expected ]]; then
      expected=$output
      printf '%s\n\n' "$output"
    fi
    if [[ $output == "$expected" ]]; then
      echo "ok    $language"
    else
      echo "DIFF  $language"; diff <(echo "$expected") <(echo "$output") | sed 's/^/      /'
      failed=1
    fi
  else
    echo "FAIL  $language"; { echo "$output"; cat "$errors"; } | tail -15 | sed 's/^/      /'
    failed=1
  fi
  rm -f "$errors"
done
exit $failed
